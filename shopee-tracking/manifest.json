{
  "manifest_version": 3,
  "name": "Shopee - Status Tracking",
  "version": "2.5.0",
  "description": "Na tela de Devoluções/Cancelamentos do Shopee Seller Center, mostra em cada pedido o status de tracking lido do arquivo Payload_Tracking no Google Drive.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://seller.shopee.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
